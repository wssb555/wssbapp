# 复制为 .env 并填写真实值

# Captcha 解码服务 (二选一)
# 2captcha: https://2captcha.com/  capsolver: https://capsolver.com/
CAPTCHA_API_KEY=your_api_key_here

# 已有账户登录（--mode login 时必填）
NEXOS_EMAIL=your@email.com
NEXOS_PASSWORD=your_password

# 临时邮箱服务（--mode register 时必填）
WORKER_DOMAIN=your.worker.domain
FREEMAIL_TOKEN=your_token

# 可选：默认模型 ID（留空则不指定）
NEXOS_MODEL_ID=

# 可选：测试文件路径（填写则上传）
TEST_FILE_PATH=

# 可选：测试消息（多轮时填 TEST_MESSAGE_2）
TEST_MESSAGE=请介绍一下你自己
TEST_MESSAGE_2=
